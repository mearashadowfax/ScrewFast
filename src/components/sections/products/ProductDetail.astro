---
import ProductTabBtn from '@components/ui/buttons/ProductTabBtn.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { copy: t } = Astro.locals;
---

<script is:inline>
  // Hide reveal targets before first paint; the module script below takes over.
  // If it never runs, the fallback timer shows the content anyway.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('pd-motion');
    window.setTimeout(function () {
      document.documentElement.classList.remove('pd-motion');
    }, 4000);
  }
</script>

<section class="mx-auto max-w-[85rem] px-4 pt-10 pb-4 sm:px-6 lg:px-8 lg:pt-16">
  <div class="grid items-center gap-y-10 lg:grid-cols-12 lg:gap-x-10">
    <div class="lg:col-span-5">
      <h1 class="overflow-hidden pb-[0.08em] text-5xl leading-[1.02] font-bold tracking-tighter text-neutral-800 sm:text-6xl lg:text-7xl dark:text-neutral-200">
        <span data-pd="title" class="block">
          {product.data.title}
        </span>
      </h1>
      <p
        data-pd="meta"
        class="mt-2 text-lg font-medium text-orange-400 dark:text-orange-300"
      >
        {product.data.description}
      </p>
      <p
        data-pd="meta"
        class="mt-6 max-w-prose font-light text-pretty text-neutral-700 sm:text-xl dark:text-neutral-300"
      >
        {product.data.main.content}
      </p>
    </div>
    <div data-pd="media" class="lg:col-span-7">
      <Image
        src={product.data.main.imgMain}
        class="h-auto w-full"
        alt={product.data.main.imgAlt}
        widths={[480, 800, 1200, 1600]}
        sizes="(min-width: 1360px) 790px, (min-width: 1024px) 58vw, 100vw"
        format={'avif'}
        loading={'eager'}
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<div
  id="product-detail-body"
  class="mx-auto max-w-[85rem] px-4 pt-10 sm:px-6 lg:px-8 lg:pt-14"
>
  <nav
    data-pd="tabs"
    class="mx-auto grid max-w-6xl gap-y-px sm:flex sm:gap-x-4 sm:gap-y-0"
    aria-label={t.products.tabs}
    role="tablist"
  >
    {product.data.tabs.map((tab, index) => (
      <ProductTabBtn
        title={tab.title}
        id={tab.id}
        dataTab={tab.dataTab}
        first={index === 0}
      />
    ))}
  </nav>

  <div class="relative mt-12 md:mt-16">
    <div id="tabs-with-card-1" class="product-tab-panel" role="tabpanel">
      <div class="pb-10 lg:pb-14">
        <div class="grid gap-12 md:grid-cols-2">
          <div data-pd-item class="lg:w-3/4">
            <h2 class="text-3xl font-bold tracking-tight text-balance text-neutral-800 md:leading-tight lg:text-4xl dark:text-neutral-200">
              {product.data.longDescription.title}
            </h2>
            <p class="mt-3 text-pretty text-neutral-600 dark:text-neutral-400">
              {product.data.longDescription.subTitle}
            </p>
            <p class="mt-5">
              <PrimaryCTA
                title={product.data.longDescription.btnTitle}
                url={product.data.longDescription.btnURL}
              />
            </p>
          </div>

          <div class="space-y-6 lg:space-y-10">
            {product.data.descriptionList.map(list => (
              <div data-pd-item class="flex">
                <div>
                  <h3 class="text-base font-bold text-neutral-800 sm:text-lg dark:text-neutral-200">
                    {list.title}
                  </h3>
                  <p class="mt-1 text-neutral-600 dark:text-neutral-400">
                    {list.subTitle}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div id="tabs-with-card-2" class="product-tab-panel hidden" role="tabpanel">
      <div class="pb-10 lg:pb-14">
        <div class="grid w-full grid-cols-1 gap-x-16 md:grid-cols-2">
          <div class="max-w-md space-y-6">
            {product.data.specificationsLeft.map(spec => (
              <div data-pd-item>
                <h3 class="block font-bold text-neutral-800 dark:text-neutral-200">
                  {spec.title}
                </h3>
                <p class="text-neutral-600 dark:text-neutral-400">
                  {spec.subTitle}
                </p>
              </div>
            ))}
          </div>
          {product.data.specificationsRight ? (
            <div class="mt-6 max-w-md space-y-6 md:mt-0 md:ml-auto">
              {product.data.specificationsRight?.map(spec => (
                <div data-pd-item>
                  <h3 class="block font-bold text-neutral-800 dark:text-neutral-200">
                    {spec.title}
                  </h3>
                  <p class="text-neutral-600 dark:text-neutral-400">
                    {spec.subTitle}
                  </p>
                </div>
              ))}
            </div>
          ) : product.data.tableData ? (
            <div data-pd-item class="mt-6 space-y-6 md:mt-0 md:ml-auto">
              <div class="flex flex-col">
                <div class="-m-1.5 overflow-x-auto">
                  <div class="inline-block min-w-full p-1.5 align-middle">
                    <div class="overflow-hidden">
                      <table class="min-w-full divide-y divide-neutral-300 dark:divide-neutral-700">
                        <thead>
                          <tr>
                            {product.data.tableData?.[0].feature?.map(
                              header => (
                                <th
                                  scope="col"
                                  class="px-6 py-3 text-start text-xs font-medium text-neutral-500 uppercase dark:text-neutral-500"
                                >
                                  {header}
                                </th>
                              )
                            )}
                          </tr>
                        </thead>
                        <tbody class="divide-y divide-neutral-300 dark:divide-neutral-700">
                          {product.data.tableData?.map(row =>
                            // Wrap each row's content in a separate <tr> element
                            row.description.map(rowData => (
                              <tr>
                                {/* Iterate through each cell value in the row's description array */}
                                {rowData.map(cellValue => (
                                  // Render each cell value in its own <td> element
                                  <td class="px-6 py-4 text-sm font-medium whitespace-nowrap text-neutral-600 dark:text-neutral-400">
                                    {cellValue}
                                  </td>
                                ))}
                              </tr>
                            ))
                          )}
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ) : null}
        </div>
      </div>
    </div>

    <div id="tabs-with-card-3" class="product-tab-panel hidden" role="tabpanel">
      <div class="mx-auto mb-20 flex w-full md:mb-28 2xl:w-4/5">
        <div
          data-pd-item
          class="relative top-12 left-12 z-10 overflow-hidden rounded-xl shadow-lg md:top-16 md:left-12 md:-ml-12 lg:ml-0"
        >
          {product.data.blueprints.first && (
            <Image
              src={product.data.blueprints.first}
              class="h-full w-full object-cover object-center"
              alt="Blueprint Illustration"
              format={'avif'}
            />
          )}
        </div>

        <div
          data-pd-item
          class="relative right-12 overflow-hidden rounded-xl shadow-xl"
        >
          {product.data.blueprints.second && (
            <Image
              src={product.data.blueprints.second}
              class="h-full w-full object-cover object-center"
              alt="Blueprint Illustration"
              format={'avif'}
            />
          )}
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Pre-paint hidden state; removed as soon as GSAP owns the elements. */
  html.pd-motion [data-pd],
  html.pd-motion #tabs-with-card-1 [data-pd-item] {
    opacity: 0;
  }
</style>

<script>
  import { gsap } from 'gsap';

  const prefersReducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  ).matches;

  const EASE_OUT = 'power3.out';

  const panelItems = (panel: Element | null) =>
    panel ? Array.from(panel.querySelectorAll('[data-pd-item]')) : [];

  if (!prefersReducedMotion) {
    const root = document.documentElement;
    const title = document.querySelector('[data-pd="title"]');
    const meta = document.querySelectorAll('[data-pd="meta"]');
    const media = document.querySelector<HTMLElement>('[data-pd="media"]');
    const img = media?.querySelector('img');
    const tabs = document.querySelector('[data-pd="tabs"]');
    const body = document.querySelector('#product-detail-body');
    const firstItems = panelItems(
      document.querySelector('.product-tab-panel:not(.hidden)')
    );

    // Take over the hidden state from CSS with inline styles GSAP can tween.
    gsap.set(title, { yPercent: 105, autoAlpha: 1 });
    gsap.set(meta, { autoAlpha: 0, y: 16 });
    gsap.set(media, { autoAlpha: 0, y: 40, scale: 0.96 });
    gsap.set([tabs, ...firstItems], { autoAlpha: 0, y: 20 });
    root.classList.remove('pd-motion');

    // Hero: title rises out of its mask, supporting copy follows.
    gsap
      .timeline({ defaults: { ease: EASE_OUT } })
      .to(title, { yPercent: 0, duration: 1, ease: 'expo.out' }, 0.05)
      .to(meta, { autoAlpha: 1, y: 0, duration: 0.7, stagger: 0.08 }, 0.3);

    // Image waits for decode (capped) so it never animates in as an empty box.
    const decoded = img?.decode ? img.decode().catch(() => {}) : null;
    Promise.race([
      decoded,
      new Promise(resolve => window.setTimeout(resolve, 600)),
    ]).then(() => {
      gsap.to(media, {
        autoAlpha: 1,
        y: 0,
        scale: 1,
        duration: 1.2,
        delay: 0.15,
        ease: 'expo.out',
        clearProps: 'transform',
      });
    });

    // Details: reveal once, when the tabs scroll into view.
    const revealBody = () =>
      gsap
        .timeline({ defaults: { ease: EASE_OUT, duration: 0.7 }, delay: 0.2 })
        .to(tabs, { autoAlpha: 1, y: 0 })
        .to(firstItems, { autoAlpha: 1, y: 0, stagger: 0.07 }, 0.12);

    if (body && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        entries => {
          if (entries.some(entry => entry.isIntersecting)) {
            io.disconnect();
            revealBody();
          }
        },
        { rootMargin: '0px 0px -10% 0px' }
      );
      io.observe(body);
    } else {
      revealBody();
    }
  }

  function changeHeadingStyle(
    button: Element,
    addClasses: string[],
    removeClasses: string[]
  ) {
    const heading = button.querySelector('span');
    if (heading) {
      heading.classList.remove(...removeClasses);
      heading.classList.add(...addClasses);
    }
  }

  function setButtonInactive(btn: Element, activeButton: Element) {
    if (btn === activeButton) return;

    btn.classList.remove(
      'active',
      'bg-neutral-100',
      'hover:border-transparent',
      'dark:bg-white/[.05]'
    );

    changeHeadingStyle(
      btn,
      ['text-neutral-800', 'dark:text-neutral-200'],
      ['text-orange-400', 'dark:text-orange-300']
    );
  }

  function setButtonActive(button: Element) {
    button.classList.add(
      'active',
      'bg-neutral-100',
      'hover:border-transparent',
      'dark:bg-white/[.05]'
    );

    changeHeadingStyle(
      button,
      ['text-orange-400', 'dark:text-orange-300'],
      ['text-neutral-800', 'dark:text-neutral-200']
    );
  }

  let activePanel = document.querySelector(
    '.product-tab-panel:not(.hidden)'
  ) as HTMLElement | null;
  let isSwitching = false;

  function switchPanel(nextPanel: HTMLElement) {
    if (!nextPanel || nextPanel === activePanel || isSwitching) return;

    if (prefersReducedMotion || !activePanel) {
      activePanel?.classList.add('hidden');
      nextPanel.classList.remove('hidden');
      activePanel = nextPanel;
      return;
    }

    isSwitching = true;
    const previousPanel = activePanel;
    activePanel = nextPanel;

    gsap.to(previousPanel, {
      autoAlpha: 0,
      y: 8,
      duration: 0.18,
      ease: 'power2.in',
      onComplete: () => {
        previousPanel.classList.add('hidden');
        gsap.set(previousPanel, { clearProps: 'all' });
        nextPanel.classList.remove('hidden');

        const items = panelItems(nextPanel);
        gsap.fromTo(
          items.length ? items : nextPanel,
          { autoAlpha: 0, y: 14 },
          {
            autoAlpha: 1,
            y: 0,
            duration: 0.45,
            stagger: 0.05,
            ease: EASE_OUT,
            clearProps: 'all',
            onComplete: () => {
              isSwitching = false;
            },
          }
        );
      },
    });
  }

  const tabButtons = document.querySelectorAll('[data-target]');

  if (tabButtons.length > 0) {
    changeHeadingStyle(
      tabButtons[0],
      ['text-orange-400', 'dark:text-orange-300'],
      []
    );
  }

  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      const tabId = button.getAttribute('data-target');
      if (!tabId) return;

      const nextPanel = document.querySelector(tabId) as HTMLElement | null;
      if (!nextPanel || nextPanel === activePanel || isSwitching) return;

      tabButtons.forEach(btn => setButtonInactive(btn, button));
      setButtonActive(button);
      switchPanel(nextPanel);
    });
  });
</script>
