---
import Icon from '@components/ui/icons/Icon.astro';

/**
 * The call-to-action button. Renders an `<a>` when given a `url`, otherwise a
 * `<button>` (give it an `id` to wire a script to it). Any other attribute
 * (`data-astro-prefetch`, `aria-*`, …) is forwarded to the element.
 */
interface Props {
  title?: string;
  url?: string;
  /** `orange` (default) or the yellow brand button. */
  variant?: 'orange' | 'yellow';
  noArrow?: boolean;
  [attribute: string]: unknown;
}

const { title, url, variant = 'orange', noArrow, ...rest } = Astro.props;

const variants = {
  orange:
    'text-neutral-50 bg-orange-400 hover:bg-orange-500 active:bg-orange-500',
  yellow: 'text-neutral-800 bg-yellow-400 hover:bg-yellow-500',
};

const classes = [
  'group inline-flex items-center justify-center gap-x-2 rounded-lg px-4 py-3 text-sm font-bold ring-zinc-500 transition duration-300 focus-visible:ring-3 outline-hidden',
  'border border-transparent',
  variants[variant],
  'disabled:pointer-events-none disabled:opacity-50 dark:focus:outline-hidden',
  '2xl:text-base',
  'dark:ring-zinc-200',
].join(' ');

const Element = url ? 'a' : 'button';
---

<Element class={classes} href={url} {...rest}>
  {title}
  {noArrow ? null : (
    <Icon
      name="arrowRight"
      class="h-4 w-4 shrink-0 transition duration-300 group-hover:translate-x-1"
    />
  )}
</Element>
