---
import EmailInput from './input/EmailInput.astro';
import PasswordInput from './input/PasswordInput.astro';
import Checkbox from './input/Checkbox.astro';
import DemoForm from './DemoForm.astro';
import GoogleBtn from '@components/ui/buttons/GoogleBtn.astro';
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';

const { copy: t } = Astro.locals;

const modalId = 'hs-toggle-between-modals-register-modal';
// Preline overlay selector of the modal the footer link switches to
const loginModalTarget = '#hs-toggle-between-modals-login-modal';
---

{/* Root element of the registration modal with the id and styling */}
<div
  id={modalId}
  class="hs-overlay hs-overlay-backdrop-open:bg-neutral-900/90 absolute start-0 top-0 z-50 hidden h-full w-full"
  data-lenis-prevent
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${modalId}-title`}
>
  <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 m-3 mt-0 opacity-0 transition-all ease-out sm:mx-auto sm:w-full sm:max-w-lg">
    <div class="mx-auto w-full max-w-md p-6">
      <div class="mt-7 flex max-h-[calc(100vh-8rem)] flex-col rounded-xl border border-neutral-200 bg-neutral-100 shadow-xs dark:border-neutral-700 dark:bg-neutral-800">
        <div class="overflow-y-auto p-4 sm:p-7">
          <div class="text-center">
            <h2
              id={`${modalId}-title`}
              class="block text-2xl font-bold text-neutral-800 dark:text-neutral-200"
            >
              {t.auth.signUp}
            </h2>
            <p
              class="mt-2 rounded-lg bg-yellow-100 px-3 py-2 text-xs text-neutral-700 dark:bg-yellow-900/40 dark:text-neutral-200"
              role="note"
            >
              {t.auth.credentialsDemoNotice}
            </p>
            <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
              {t.auth.alreadyHaveAccount}
              {/* Button to toggle login modal */}
              <button
                type="button"
                class="rounded-lg p-1 font-medium text-orange-400 decoration-2 ring-zinc-500 outline-hidden hover:underline focus-visible:ring-3 dark:text-orange-400 dark:ring-zinc-200 dark:focus:outline-hidden"
                data-hs-overlay={loginModalTarget}
              >
                {t.auth.signInHere}
              </button>
            </p>
          </div>
          {/* The form for user registration */}
          <div class="mt-5">
            <GoogleBtn title={t.auth.signUpWithGoogle} />
            {/* Dividing line with 'Or' text */}
            <div class="flex items-center py-3 text-xs text-neutral-400 uppercase before:me-6 before:flex-[1_1_0%] before:border-t before:border-neutral-200 after:ms-6 after:flex-[1_1_0%] after:border-t after:border-neutral-200 dark:text-neutral-500 dark:before:border-neutral-600 dark:after:border-neutral-600">
              {t.forms.or}
            </div>
            <DemoForm
              successMessage={t.auth.registerDemoMessage}
              statusClass="mt-4 text-center text-sm text-neutral-600 dark:text-neutral-400"
            >
              <div class="grid gap-y-4">
                <EmailInput
                  id="register-email"
                  errorId="register-email-error"
                />
                <PasswordInput
                  id="create-password"
                  errorId="register-password-error"
                  content={t.forms.passwordHint}
                />
                <PasswordInput
                  label={t.forms.confirmPassword}
                  id="confirm-password"
                  errorId="confirm-password-error"
                  content={t.forms.passwordMismatch}
                />
                {/* Checkbox with a label and a link for accepting the terms and conditions */}
                <Checkbox label={t.forms.acceptTerms} id="terms-agree">
                  <a
                    class="font-medium text-orange-400 decoration-2 hover:underline dark:text-orange-400 dark:focus:outline-hidden"
                    href="#"
                  >
                    {t.forms.termsAndConditions}
                  </a>
                </Checkbox>
                <AuthBtn title={t.auth.signUp} />
              </div>
            </DemoForm>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
